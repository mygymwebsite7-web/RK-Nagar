{
  "version": 2,
  "outputDirectory": "public",
  "routes": [
    { "src": "/api/debug",                "dest": "/api/debug.js" },
    { "src": "/api/complaints/dashboard", "dest": "/api/complaints/dashboard.js" },
    { "src": "/api/complaints/([^/]+)",   "dest": "/api/complaints/[complaintId].js?complaintId=$1" },
    { "src": "/api/complaints",           "dest": "/api/complaints/index.js" },
    { "src": "/api/admin/login",          "dest": "/api/admin/login.js" },
    { "src": "/api/admin/complaints",     "dest": "/api/admin/complaints.js" },
    { "src": "/api/admin/([^/]+)",        "dest": "/api/admin/[id].js?id=$1" },
    { "src": "/report",                   "dest": "/report.html" },
    { "src": "/track",                    "dest": "/track.html" },
    { "src": "/dashboard",               "dest": "/dashboard.html" },
    { "src": "/about",                   "dest": "/about.html" },
    { "src": "/contact",                 "dest": "/contact.html" },
    { "src": "/admin",                   "dest": "/admin.html" },
    { "src": "/(.*)",                    "dest": "/$1" }
  ]
}
