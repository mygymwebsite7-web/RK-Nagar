# ─────────────────────────────────────────────────────────────
#  TVK Complaint Box – Environment Variables
#  Copy this file to .env and fill in your real values.
#  Then run:  node setup-env.cjs   (generates ADMIN_PASSWORD_HASH)
# ─────────────────────────────────────────────────────────────

# Supabase (get from: supabase.com → Your Project → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin login credentials
ADMIN_USERNAME=tvkadmin
# Run "node setup-env.cjs" to auto-generate this hash from your password
ADMIN_PASSWORD_HASH=$2a$10$...bcrypt_hash_of_your_password...

# JWT secret – any long random string
JWT_SECRET=tvk-rknagar-super-secret-jwt-2024-xK9mP3qL
